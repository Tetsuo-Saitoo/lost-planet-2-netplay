// LP2 Netplay version, generated by CMake into build\generated\lp2net_version.h. The one place to change it is
// project(VERSION ...) in CMakeLists.txt.
#pragma once

#define LP2NET_VERSION "@PROJECT_VERSION@"
#define LP2NET_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define LP2NET_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define LP2NET_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define LP2NET_VERSION_COMMA @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
