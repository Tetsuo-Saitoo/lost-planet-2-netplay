; xlive.dll replacement for Lost Planet 2.
; Every ordinal of Capcom's 2025 "xlive-dummy" stub is exported. This file lists the ones we implement
; (networking, sessions, users, notifications, frame/input hooks); forwards.cpp forwards the rest to Capcom's
; stub, which the installer keeps as xlive_capcom.dll.
LIBRARY xlive
EXPORTS
	XWSAStartup                         @1     NONAME
	XWSACleanup                         @2     NONAME
	XSocketCreate                       @3     NONAME
	XSocketClose                        @4     NONAME
	XSocketShutdown                     @5     NONAME
	XSocketIOCTLSocket                  @6     NONAME
	XSocketSetSockOpt                   @7     NONAME
	XSocketGetSockOpt                   @8     NONAME
	XSocketGetSockName                  @9     NONAME
	XSocketGetPeerName                  @10    NONAME
	XSocketBind                         @11    NONAME
	XSocketConnect                      @12    NONAME
	XSocketListen                       @13    NONAME
	XSocketAccept                       @14    NONAME
	XSocketSelect                       @15    NONAME
	XSocketRecv                         @18    NONAME
	XSocketRecvFrom                     @20    NONAME
	XSocketSend                         @22    NONAME
	XSocketSendTo                       @24    NONAME
	XWSASendTo                          @25    NONAME
	XSocketInet_Addr                    @26    NONAME
	XWSAGetLastError                    @27    NONAME
	XWSAFDIsSet                         @34    NONAME
	XSocketNTOHS                        @38    NONAME
	XSocketHTONS                        @40    NONAME

