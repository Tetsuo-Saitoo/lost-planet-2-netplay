// VERSIONINFO shared by xlive.dll and LP2NetSetup.exe. The including .rc defines VER_FILEDESC, VER_INTERNAL,
// VER_ORIGNAME and VER_FILETYPE. LP2NetSetup recognises an installed xlive.dll as ours by ProductName.
#include <winver.h>

#include "lp2net_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LP2NET_VERSION_COMMA
PRODUCTVERSION LP2NET_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VER_FILETYPE
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "LP2 Netplay contributors"
			VALUE "FileDescription", VER_FILEDESC
			VALUE "FileVersion", LP2NET_VERSION
			VALUE "InternalName", VER_INTERNAL
			VALUE "LegalCopyright", "MIT License. Not affiliated with Capcom, Microsoft or Valve."
			VALUE "OriginalFilename", VER_ORIGNAME
			VALUE "ProductName", "LP2 Netplay"
			VALUE "ProductVersion", LP2NET_VERSION
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
